# ngfsystems.com — environment variables
#
# Copy to .env.local for local work, and set the same names in the Vercel
# project. Never commit .env.local.

# The site's own production domain. MUST match this client's
# client_configs.site_url in the NGF app exactly (case, www and trailing
# slash are normalised, nothing else is) — otherwise the content lookup finds
# no record and every page renders its hardcoded fallbacks instead of the
# published content. It is also the host app/sitemap.ts emits, so a wrong or
# missing value tells Google the pages live somewhere they do not.
NEXT_PUBLIC_SITE_URL=https://ngfsystems.com

# Transactional email for the contact form (Resend). Without it the enquiry is
# still persisted to the portal, but no notification email is sent.
RESEND_API_KEY=

# Presented to the NGF app when relaying an enquiry to /api/leads/ingest.
LEADS_API_SECRET=

# Shared with this client's client_configs.revalidation_secret in the NGF app.
# Must be that exact name — the portal cannot satisfy any other. Set it on
# production AND preview, or an instant publish silently falls back to the
# 60-second ISR window.
WEBSITE_REVALIDATION_SECRET=

# Google Analytics 4. Falls back to the id hardcoded in lib/analytics.ts.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional. Only set to pin this site to one client record by id instead of
# looking it up by domain; leave unset so the domain lookup is used.
# NGF_CLIENT_ID=
